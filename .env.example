# Public HTTPS origin served by the proxy, with no path.
THEIRCARE_PUBLIC_URL=https://homeserver.tailef5484.ts.net
# Google OAuth web client. Authorized redirect URI: <THEIRCARE_PUBLIC_URL>/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed to sign in.
THEIRCARE_OWNER_EMAIL=
# Let connected AI apps save bookings and cancellations (accepting TheirCare terms) after you agree in chat.
THEIRCARE_ALLOW_AI_SAVE=false
